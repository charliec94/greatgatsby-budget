# Generate a unique value before deploying to Unraid.
APP_SECRET_KEY=replace-with-a-long-random-value

# Optional email invitations. Leave credentials empty for link-only invitations.
# Use the LAN address reachable by household members, not localhost.
APP_BASE_URL=http://192.168.1.100:8081
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
